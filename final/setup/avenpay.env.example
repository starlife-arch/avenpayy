# Copy to /home/<cpanel-user>/avenpay.env  (ONE LEVEL ABOVE public_html, never inside it)  and chmod 600
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Encrypts stored Daraja credentials. Fresh install: generate with   php -r "echo bin2hex(random_bytes(32));"
# Existing data: see DEPLOY.md, section "Existing database".
VAULT_KEY=

# Authenticates M-Pesa callbacks. REQUIRED, or every callback is rejected.  php -r "echo bin2hex(random_bytes(32));"
CALLBACK_SECRET=

APP_URL=https://avenpay.co.ke

# Outgoing email (password resets, withdrawal codes)
SMTP_HOST=mail.avenpay.co.ke
SMTP_USERNAME=no-reply@avenpay.co.ke
SMTP_PASSWORD=
SMTP_PORT=465
MAIL_FROM=no-reply@avenpay.co.ke

# 1 = dashboard withdrawals also need a 6-digit code emailed to the merchant (needs working SMTP above)
WITHDRAW_OTP=0

# Max total B2C+B2B payouts per merchant per day (KES). 0 = no limit.
B2C_DAILY_LIMIT=150000

# Admin social login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
